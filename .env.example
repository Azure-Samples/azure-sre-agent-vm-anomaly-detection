# Copy to .env, fill in these values, then load explicitly as described in docs/10-environment-setup.md.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
GITHUB_REPOSITORY=

DASHBOARD_TENANT_ID="${AZURE_TENANT_ID}"
DASHBOARD_SUBSCRIPTION_ID="${AZURE_SUBSCRIPTION_ID}"
DASHBOARD_REPO="${GITHUB_REPOSITORY}"
# Set after deployment for the detector's direct portal link.
DASHBOARD_FUNCTION_APP=
